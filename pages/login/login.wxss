/* pages/login/login.wxss */
.login-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  /* Beautiful gradient background as fallback */
  background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #f093fb 50%, #f5576c 75%, #4facfe 100%);
  background-size: 400% 400%;
  animation: gradientShift 15s ease infinite;
}

@keyframes gradientShift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* Background image */
.background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  opacity: 0.8;
  /* Hide if image fails to load, showing gradient instead */
  display: none;
}

/* Semi-transparent overlay */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  z-index: 2;
}

/* Form container */
.form-container {
  position: relative;
  width: 80%;
  max-width: 400px;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10rpx);
  z-index: 3;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* Tab header */
.tab-header {
  display: flex;
  margin-bottom: 40rpx;
  border-radius: 12rpx;
  background: rgba(245, 245, 245, 0.8);
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.4);
}

/* Form content */
.form-content {
  animation: fadeIn 0.5s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Avatar section */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  border: 4rpx solid #e0e0e0;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
}

.avatar-container:active {
  transform: scale(0.95);
  border-color: #667eea;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.avatar-placeholder::before {
  content: "📷";
  font-size: 32rpx;
  position: absolute;
  top: 20rpx;
}

.avatar-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 20rpx;
}

/* Input groups */
.input-group {
  position: relative;
  margin-bottom: 30rpx;
}

.input-field {
  width: 100%;
  height: 90rpx;
  background: rgba(245, 245, 245, 0.8);
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s ease;
}

.input-field:focus {
  background: white;
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.input-field::placeholder {
  color: #999;
}

/* Character count */
.char-count {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #999;
}

/* Primary button */
.primary-button {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  border-radius: 12rpx;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.primary-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.primary-button:active::before {
  left: 100%;
}

.primary-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.4);
}

.primary-button[disabled] {
  background: linear-gradient(135deg, #cccccc 0%, #999999 100%);
  box-shadow: none;
  transform: none;
}

.primary-button::after {
  border: none;
}

/* Hover effects for button (for development/testing) */
.primary-button:hover {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.4);
}

/* Responsive adjustments */
@media (max-width: 375px) {
  .form-container {
    width: 90%;
    padding: 50rpx 30rpx;
  }
  
  .input-field {
    height: 80rpx;
    font-size: 26rpx;
  }
  
  .primary-button {
    height: 80rpx;
    font-size: 30rpx;
  }
}