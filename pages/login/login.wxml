<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- Background image -->
  <image class="background-image" src="/images/background1.jpg" mode="aspectFill"></image>
  
  <!-- Semi-transparent overlay -->
  <view class="overlay"></view>
  
  <!-- Login form container -->
  <view class="form-container">
    <!-- Tab headers -->
    <view class="tab-header">
      <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
        登录
      </view>
      <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
        注册
      </view>
    </view>
    
    <!-- Login form -->
    <view class="form-content" wx:if="{{currentTab === 0}}">
      <view class="input-group">
        <input class="input-field" placeholder="请输入用户名" value="{{loginForm.username}}" bindinput="onLoginUsernameInput"/>
      </view>
      <view class="input-group">
        <input class="input-field" placeholder="请输入密码" password="{{true}}" value="{{loginForm.password}}" bindinput="onLoginPasswordInput"/>
      </view>
      <button class="primary-button" bindtap="handleLogin">登录</button>
    </view>
    
    <!-- Register form -->
    <view class="form-content" wx:if="{{currentTab === 1}}">
      <!-- Avatar selection -->
      <view class="avatar-section">
        <view class="avatar-container" bindtap="selectAvatar">
          <image wx:if="{{registerForm.avatar}}" class="avatar-preview" src="{{registerForm.avatar}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">
            <text class="avatar-text">选择头像</text>
          </view>
        </view>
      </view>
      
      <!-- Nickname input -->
      <view class="input-group">
        <input class="input-field" placeholder="请输入昵称" value="{{registerForm.nickname}}" bindinput="onNicknameInput" maxlength="20"/>
        <text class="char-count">{{registerForm.nickname.length}}/20</text>
      </view>
      
      <view class="input-group">
        <input class="input-field" placeholder="请输入用户名" value="{{registerForm.username}}" bindinput="onRegisterUsernameInput"/>
      </view>
      
      <view class="input-group">
        <input class="input-field" placeholder="请输入密码" password="{{true}}" value="{{registerForm.password}}" bindinput="onRegisterPasswordInput"/>
      </view>
      
      <view class="input-group">
        <input class="input-field" placeholder="请确认密码" password="{{true}}" value="{{registerForm.confirmPassword}}" bindinput="onConfirmPasswordInput"/>
      </view>
      
      <button class="primary-button" bindtap="handleRegister" disabled="{{!isRegisterValid}}">注册</button>
    </view>
  </view>
</view>